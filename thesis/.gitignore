# ==============================================================================
# LaTeX build artifacts — only .tex, .bib, .md, figures/, .latexmkrc are kept
# ==============================================================================

# Core compiler outputs
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.synctex.gz
*.fls
*.fdb_latexmk

# Bibliography
*.bbl
*.blg

# Index / makeindex
*.idx
*.ilg
*.ind
*.ist

# Glossaries (standard: glossaries package)
*.glo
*.gls
*.glg
*.glsdefs
*.acn
*.acr
*.alg

# Glossaries-extra (abbreviation type — suffix -abr)
*.glo-abr
*.gls-abr
*.glg-abr

# Beamer / slides
*.nav
*.snm
*.vrb

# Keep the final built PDF tracked
!main.pdf

# Editor backups
*~
*.bak
*.swp

# OS files
.DS_Store
Thumbs.db
